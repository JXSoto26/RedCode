# Copy to .env.local and fill in real values. Never commit .env.local.
# None of these are NEXT_PUBLIC_: they are only read on the server.

# --- Supabase (use the DEV project for local testing, never production) ---
# Project URL: https://<project-ref>.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_...) or legacy service_role key. Server only — bypasses RLS.
# Used only by the public form flow, never by the admin panel.
SUPABASE_SECRET_KEY=
# Publishable key (sb_publishable_...). The /admin panel uses it on the server
# with the signed-in user's session, so RLS applies. Also used by test:dev.
SUPABASE_PUBLISHABLE_KEY=
# Random string used to hash IPs/emails for rate limiting. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
QUOTE_RATE_LIMIT_SECRET=

# --- Email via Resend (optional; without it requests are saved and marked "omitido") ---
RESEND_API_KEY=
# Sender. Must be a domain verified in Resend (DEV can use: RedCode <onboarding@resend.dev>)
QUOTE_EMAIL_FROM=
# Internal recipient for new-request notifications.
QUOTE_NOTIFY_EMAIL=
# Optional Reply-To for visitor confirmations. Leave empty to omit.
QUOTE_EMAIL_REPLY_TO=
# Delivery safety: by default ONLY addresses in QUOTE_EMAIL_ALLOWLIST receive email
# (comma-separated). Set QUOTE_EMAIL_DELIVERY=all only in production.
QUOTE_EMAIL_ALLOWLIST=
QUOTE_EMAIL_DELIVERY=allowlist

# --- Anti-spam: Cloudflare Turnstile on /cotizar ---
# Required in Production (real keys + expected hostnames), otherwise the form stays
# disabled. Elsewhere it is enforced whenever both keys are set; Cloudflare's
# public test keys (1x00000000000000000000AA / 1x0000000000000000000000000000000AA)
# are allowed only outside Production. The site key is public; the secret is not.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames the token must come from (Production: required).
TURNSTILE_EXPECTED_HOSTNAMES=

# --- Production only (Vercel Production env, or .env.prod.local for scripts/prod-*.ts) ---
# Ref of the Supabase PROD project. Production refuses to build/start unless
# SUPABASE_URL is exactly this project (and never DEV).
SUPABASE_PROD_PROJECT_REF=

# --- DEV-only integration tests (npm run test:dev) ---
# Project ref of the DEV project; the tests refuse to run if SUPABASE_URL doesn't match it.
SUPABASE_DEV_PROJECT_REF=
